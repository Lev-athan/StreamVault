# --- Supabase ---
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server only, NEVER expose to the client/browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket name for video files (create this bucket, keep it PRIVATE)
NEXT_PUBLIC_SUPABASE_VIDEO_BUCKET=videos

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price IDs from the Stripe Dashboard (Products > Pricing)
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_xxx

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
